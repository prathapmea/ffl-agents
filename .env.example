PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
MODEL_DEPLOYMENT=gpt-4.1

# Optional: raise a real GitHub issue when a new ticket is accepted.
# Token needs the "Issues: write" permission on the repo (fine-grained PAT) or classic "repo" scope.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# GITHUB_REPO=your-org/your-repo

# Pin the tenant so az CLI context drift cannot break runs
# AZURE_TENANT_ID=<tenant-guid>
